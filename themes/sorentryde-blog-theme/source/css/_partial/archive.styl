.archives-wrap
  margin-bottom: 25px

.archives
  clearfix()

.archive-year-wrap
  margin-bottom: 1em

.archive-year

.archives


.archive-article
  avoid-column-break()

.archive-article-inner
  padding: 10px

.archive-article-title
  text-decoration: none
  font-weight: bold
  color: color-default
  transition: color 0.2s
  line-height: line-height
  &:hover
    color: color-link

.archive-article-footer
  margin-top: 1em

.archive-article-date
  color: color-grey
  text-decoration: none
  font-size: 0.85em
  line-height: 1em
  margin-bottom: 0.5em
  display: block