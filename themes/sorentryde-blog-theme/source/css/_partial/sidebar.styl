.sidebar-wrapper {
  background: #23272e;
  color: #e0e0e0;
}
.sidebar-wrapper a {
  color: #8ab4f8;
}
.sidebar-wrapper a:hover {
  color: #bb86fc;
}
.sidebar-wrapper .profile-container {
  padding: 28px;
  background: rgba(30, 32, 34, 0.7);
  text-align: center;
  color: #e0e0e0;
}
.sidebar-wrapper .name {
  font-size: 26px;
  font-weight: 900;
  margin-top: 0;
  margin-bottom: 10px;
  color: #d0d0d0;
}
.sidebar-wrapper .tagline {
  color: #b0b0b0;
  font-size: 18px;
  font-weight: 400;
  margin-top: 0;
  margin-bottom: 0;
}
.sidebar-wrapper .profile {
  margin-bottom: 15px;
}
.sidebar-wrapper .container-block {
  padding: 28px;
}
.sidebar-wrapper .container-block-title {
  text-transform: uppercase;
  font-size: 16px;
  font-weight: 700;
  margin-top: 0;
  margin-bottom: 15px;
  color: #8ab4f8;
}
.sidebar-wrapper .degree {
  font-size: 14px;
  margin-top: 0;
  margin-bottom: 5px;
  color: #e0e0e0;
}
.sidebar-wrapper .education-container .item {
  margin-bottom: 15px;
}
.sidebar-wrapper .education-container .item:last-child {
  margin-bottom: 0;
}
.sidebar-wrapper .education-container .meta {
  color: #b0b0b0;
  font-weight: 500;
  margin-top: 0;
  font-size: 14px;
  margin-bottom: 5px;
}
.sidebar-wrapper .education-container .time {
  color: #8ab4f8;
  font-weight: 500;
  margin-bottom: 0px;
  font-style: italic;
}
.sidebar-wrapper .languages-container .lang-desc {
  color: #b0b0b0;
}
.sidebar-wrapper .languages-list {
  margin-bottom: 0;
}
.sidebar-wrapper .languages-list li {
  margin-bottom: 10px;
}
.sidebar-wrapper .languages-list li:last-child {
  margin-bottom: 0;
}
.sidebar-wrapper .interests-list {
  margin-bottom: 0;
}
.sidebar-wrapper .interests-list li {
  margin-bottom: 10px;
}
.sidebar-wrapper .interests-list li:last-child {
  margin-bottom: 0;
}

.sidebar-wrapper .contact-info-button {
  padding-right: 10px;
  padding-left: 10px;
}

.sidebar-wrapper .changelog-list {
  line-height: 1.6;
  color: #545e6c;
  font-size: 13px;
}

.profile-img {
  max-width: 150px;
  margin-bottom: 15px;
  border: 2px solid #205682;      /* Dark gray border */
  border-radius: 100%;
  box-shadow: 0 2px 8px #222;  /* Subtle shadow for depth */

}