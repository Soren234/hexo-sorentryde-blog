<% if (site.posts.length){ %>
  <div class="education-container container-block">
    <h3 class="container-block-title">Recent Posts</h3>
    <div class="widget">
      <ul>
        <% site.posts.sort('date', -1).limit(5).each(function(post){ %>
          <li class="item">
              <h4 class="degree"><a href="<%- url_for(post.path) %>" style="font-weight:700"><%= post.title || '(no title)' %></a></h4>
              <div class="time"><%- date(post.date) %></div>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
<% } %>