<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <%
    var title = page.title;

    if (is_archive()){
        title = __('archive');

        if (is_month()){
            title += ': ' + page.year + '/' + page.month;
        } else if (is_year()){
            title += ': ' + page.year;
        }
    } else if (is_category()){
        title = __('category') + ': ' + page.category;
    } else if (is_tag()){
        title = __('tag') + ': ' + page.tag;
    }
    %>
    <title><% if (title){ %><%= title %> | <% } %><%= config.title %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5">
    <meta name="Description" content="Sorentryde.dk blog made by Søren Tryde Andersen.">
    <% if (theme.rss){ %>
        <link rel="alternate" href="<%= url_for(theme.rss) %>" title="<%= config.title %>" type="application/atom+xml">
    <% } %>
    <% if (theme.favicon){ %>
        <link rel="icon" href="<%- theme.favicon %>">
    <% } %>
    <%- css('css/bundled.css') %>
    <%- css('css/style.css') %>
    <!-- Include the script that enables Netlify Identity on this page. -->
    <script
            src="https://cdn.jsdelivr.net/npm/netlify-identity-widget@1/build/netlify-identity-widget.min.js"
            async
            defer
    ></script>
    <link href="../admin/config.json" type="text/yaml" rel="cms-config-url">

</head>