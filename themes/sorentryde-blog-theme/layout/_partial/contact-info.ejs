<div class="contact-container container-block">
    <h2 class="container-block-title">Contact info</h2>
    <div class="row">
        <div class="col-md-auto">
        <% if(config.email) { %>
        <a type="button" class="btn btn-outline-light btn-circle" href="mailto:<%- config.email %>" data-placement="bottom"
           data-toggle="tooltip" title="<%- config.email %>"><i data-feather="mail" stroke-width="2" class="feather-18"></i>
        </a>
        <% } %>

        <% if(config.phone) { %>
        <a type="button" class="btn btn-outline-light btn-circle" href="tel:<%- config.phone %>" data-placement="bottom"
           data-toggle="tooltip" title="<%- config.phone %>"><i data-feather="phone" stroke-width="2" class="feather-18"></i>
        </a>
        <% } %>

        <% if(config.website) { %>
        <a type="button" class="btn btn-outline-light btn-circle" href="http://<%- config.website %>" data-placement="bottom"
           data-toggle="tooltip" title="http://<%- config.website %>"><i data-feather="globe" stroke-width="2" class="feather-18"></i>
        </a>
        <% } %>

        <% if(config.website) { %>
        <a type="button" class="btn btn-outline-light btn-circle" href="https://linkedin.com/in/<%- config.linkedin %>" target="_blank" data-placement="bottom"
           data-toggle="tooltip" title="https://linkedin.com/in/<%- config.linkedin %>"><i data-feather="linkedin" stroke-width="2" class="feather-18"></i>
        </a>
        <% } %>

        <% if(config.github) { %>
        <a type="button" class="btn btn-outline-light btn-circle" href="http://github.com/<%- config.github %>" target="_blank" data-placement="bottom"
           data-toggle="tooltip" title="http://github.com/<%- config.github %>"><i data-feather="github" stroke-width="2" class="feather-18"></i>
        </a>
        <% } %>

        <% if(config.twitter) { %>
        <a type="button" class="btn btn-outline-light btn-circle" href="https://twitter.com/<%- config.twitter %>" target="_blank"
           data-toggle="tooltip" title="https://twitter.com/<%- config.twitter %>"><i data-feather="twitter" stroke-width="2" class="feather-18"></i>
        </a>
        <% } %>
        </div>
    </div>
</div><!--//contact-container-->
<%- partial('_partial/data/education') %>
<%- partial('_widget/recent_posts') %>