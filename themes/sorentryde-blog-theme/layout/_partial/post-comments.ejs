<section class="content__item">
    <div class="comment-form-wrapper" id="comment-form-wrapper">
        <form class="comment-form" method="POST"
              action="http://blog-comment-system.herokuapp.com/v2/entry/<%- theme.staticman %>master/comments"
              id="comment-form">
            <input type="hidden" name="options[origin]" value="<%- config.url %><%- config.root %><%- post.path %>">
            <input type="hidden" name="options[parent]" value="<%- post.slug %>">
            <input type="hidden" name="options[redirect]" value="<%- config.url %><%- config.root %><%- post.path %>">
            <input type="hidden" name="options[slug]" value="<%- post.slug %>">
            <input type="hidden" name="fields[reply]" value="" id="comment-form-reply">
            <input type="hidden" name="fields[replyTarget]" value="" id="comment-form-reply-target">
            <span class="comment-form__input-wrapper">
        <input autocomplete="off" spellcheck="false" class="comment-form__input" name="fields[name]" type="text"
               placeholder="Name"/>
      </span>
            <span class="comment-form__input-wrapper">
        <input autocomplete="off" spellcheck="false" class="comment-form__input" name="fields[email]" type="email"
               placeholder="Email"/>
      </span>
            <span class="comment-form__input-wrapper">
      <textarea class="comment-form__input comment-form__input&#45;&#45;textarea" name="fields[message]" placeholder="Message（Markdown）"
                id="comment-form-message"></textarea>
      </span>
            <input type="submit" class="comment-form__input comment-form__input&#45;&#45;button" id="comment-submit-button"
                   value="Submit">
            <input type="hidden" name="fields[path]" value="<%- post.path %>">
        </form>
<!--        <form method="POST" action="http://blog-comment-system.herokuapp.com/v2/entry/<%- theme.staticman %>master/comments">
            <input name="options[redirect]" type="hidden" value="<%- config.url %><%- config.root %><%- post.path %>">
            <input name="options[parent]" type="hidden" value="<%- post.slug %>">
            &lt;!&ndash; e.g. "2016-01-02-this-is-a-post" &ndash;&gt;
            <input name="options[slug]" type="hidden" value="<%- post.slug %>">
            <label><input name="fields[name]" type="text">Name</label>
            <label><input name="fields[email]" type="email">E-mail</label>
            <label><textarea name="fields[body]"></textarea>Message</label>

            <button type="submit">Go!</button>
        </form>-->
    </div>
    <div class="comment-button" id="comment-button" style="display:none;"><a class="comment-button__link"
                                                                             href="javascript:void(0);"
                                                                             onclick="comment.addComment();return false;">Add
            comment</a></div>
</section>
<script>
    var comment = (function () {
        var initialized = false;
        var previousCommentItemFormWrapper = null;
        var commentFormWrapper = document.getElementById("comment-form-wrapper");
        var commentFormHtml = commentFormWrapper.innerHTML;
        var commentButton = document.getElementById("comment-button");
        var modifyForm = function (index, value) {
            document.forms[0].elements[index].value = value;
        }
        var addComment = function () {
            if (previousCommentItemFormWrapper != null) {
                previousCommentItemFormWrapper.innerHTML = "";
            }
            if (commentFormWrapper.innerHTML.length > 0) {
                return;
            }
            commentFormWrapper.innerHTML = commentFormHtml;
            commentButton.style.display = "none"
            modifyForm(4, "");
            modifyForm(5, "");
            modifyForm(9, "");
            modifyForm(10, "提交评论");
        }
        var replyTo = function (name, id) {
            var commentItemFormWrapper = document.getElementById("comment-item-form-wrapper-" + id);
            if (commentItemFormWrapper.innerHTML.length > 0) {
                return;
            }
            if (previousCommentItemFormWrapper != null) {
                previousCommentItemFormWrapper.innerHTML = "";
            }
            previousCommentItemFormWrapper = commentItemFormWrapper;
            commentFormWrapper.innerHTML = "";
            commentItemFormWrapper.innerHTML = commentFormHtml;
            commentButton.style.display = "block"
            modifyForm(4, id);
            modifyForm(5, name);
            modifyForm(9, "");
            modifyForm(10, "回复    " + name);
        };
        var init = function () {
            if (initialized) {
                return;
            }
            modifyForm(2, window.location.href);
            initialized = true;
        }
        return {init: init, addComment: addComment, replyTo: replyTo};
    })();
    comment.init();
</script>
<% if(theme.comment_history){ %>
    <section class="content__item">
        <%
            var commentArray = [];
            var slug = post.slug;
            for (i in site.data) {
                var nameArray = i.split('/');
                if(nameArray[0] == "comments") {
                    if (site.data[i]._parent == slug) {
                        commentArray.push(site.data[i]);
                    }
                }
            }
        %>
        <% if(commentArray.length > 0){ %>
            <div class="comment">
                <ul class="comment__list">
                    <% for(var i = commentArray.length - 1;i >= 0;i--){

                        var comment = commentArray[i];
                        var commentDate = new Date(comment.date);
                        comment.date = date(commentDate, 'YYYY/MM/DD');

                        var commentName = comment.name;
                        var commentMessage = comment.message;

                        console.log(comment);
                    %>
                    <li class="comment__list-item">
                        <div class="comment__box" id="comment-item-<%- comment._id %>">
                            <div class="comment__header">
                            <span class="comment__author-name">
                                <% if(typeof comment.url === "string" && comment.url.length > 0){ %>
                                    <a href="<%- comment.url %>" title="<%- commentName %>的链接"
                                       target="_blank"><%- commentName %></a>
                                <% }else{ %>
                                    <%- commentName %>
                                <% } %>
                            </span>
                                <span class="comment__submit-date"><%- comment.date %></span>
                                <% if(theme.comment_enable){ %>
                                    <span class="comment__reply-button"><a href="javascript:void(0);"
                                                                           onclick="comment.replyTo('<%- commentName %>','<%- comment._id %>');return false;">Reply</a></span>
                                <% } %>
                            </div>
                            <div class="comment__content">
                                <% if (typeof comment.reply != "undefined" && comment.reply.length > 0) {
                                    commentMessage = "[@" + comment.replyTarget + "](#comment-item-" + comment.reply + ")&nbsp;&nbsp;&nbsp;&nbsp;" + commentMessage;
                                } %>
                                <%- markdown(commentMessage) %>
                            </div>
                            <div class="comment__form-wrapper" id="comment-item-form-wrapper-<%- comment._id %>"></div>
                        </div>
                    </li>
                    <% } %>
                </ul>
            </div>
        <% }else{ %>
            <div class="comment-empty">No comments yet</div>
        <% } %>
    </section>
<% } %>