<section>
    <div id="comment-form-wrapper" style="margin-top: 10px;">
        <form method="POST"
              action="http://blog-comment-system.herokuapp.com/v2/entry/<%- theme.staticman %>master/comments"
              id="comment-form">
            <input type="hidden" name="options[origin]" value="<%- config.url %><%- config.root %><%- post.path %>">
            <input type="hidden" name="options[parent]" value="<%- post.slug %>">
            <input type="hidden" name="options[redirect]" value="<%- config.url %><%- config.root %><%- post.path %>">
            <input type="hidden" name="options[redirectError]" value="<%- config.url %><%- config.root %><%- post.path %>">
            <input type="hidden" name="options[slug]" value="<%- post.slug %>">
            <input type="hidden" name="fields[reply]" value="" id="comment-form-reply">
            <input type="hidden" name="fields[replyTarget]" value="" id="comment-form-reply-target">
            <input type="hidden" name="options[reCaptcha][siteKey]" value="<%- theme.reCaptcha.siteKey %>">
            <input type="hidden" name="options[reCaptcha][secret]" value="<%- theme.reCaptcha.secret %>">

            <div class="form-group input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"> <i data-feather="user" class="feather-16" stroke-width="2"></i> </span>
                </div>
                <input class="form-control" placeholder="Please enter your name *" name="fields[name]" data-error="Name is required." required="required">
                <div class="help-block with-errors"></div>
            </div>

            <div class="form-group input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"> <i data-feather="mail" class="feather-16" stroke-width="2"></i> </span>
                </div>
                <input class="form-control" placeholder="Please enter your email *" name="fields[email]" data-error="Email is required." required="required">
                <div class="help-block with-errors"></div>
            </div>

            <div class="form-group input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"> <i data-feather="message-circle" class="feather-16" stroke-width="2"></i> </span>
                </div>
                <textarea class="form-control" placeholder="Please enter a massage (Markdown) *" name="fields[message]" rows="7" data-error="Message is required." required="required"></textarea>
            </div>

            <div class="form-group">
                <div class="g-recaptcha" data-sitekey="<%- theme.reCaptcha.siteKey %>" data-callback="verifyRecaptchaCallback" data-expired-callback="expiredRecaptchaCallback"></div>
                <div class="help-block with-errors"></div>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-success btn-send" id="comment-submit-button">Submit comment</button>
                <input type="hidden" name="fields[path]" value="<%- post.path %>">
            </div>

        </form>
    </div>
</section>

<hr>

<% if(theme.comment_history){ %>
    <%
        var commentArray = [];
        var slug = post.slug;
        for (i in site.data) {
            var nameArray = i.split('/');
            if(nameArray[0] == "comments") {
                if (site.data[i]._parent == slug) {
                    commentArray.push(site.data[i]);
                }
            }
        }
    %>
    <% if(commentArray.length > 0){ %>

    <div class="container">

        <% for(var i = commentArray.length - 1;i >= 0;i--){

            var comment = commentArray[i];
            var commentDate = new Date(comment.date);
            comment.date = date(commentDate, 'YYYY/MM/DD');

            var commentName = comment.name;
            var commentMessage = comment.message;
        %>

        <div class="row" id="comment-item-<%- comment._id %>">
            <div class="media comment-box">
                <div class="media-left">
                    <a href="#">
                        <img class="img-responsive user-photo" src="https://ssl.gstatic.com/accounts/ui/avatar_2x.png">
                    </a>
                </div>
                <div class="media-body">
                    <div class="media-heading"><%- commentName %>
                        <span style="float: right;">
                            <span class="text-muted"><%- comment.date %></span>
                            <% if(theme.comment_reply){ %>
                                <strong><a href="javascript:void(0);" onclick="comment.replyTo('<%- commentName %>','<%- comment._id %>');return false;">Reply</a></strong>
                            <% } %>
                        </span>
                    </div>
                    <% if (typeof comment.reply != "undefined" && comment.reply.length > 0) {
                        commentMessage = "[@" + comment.replyTarget + "](#comment-item-" + comment.reply + ")&nbsp;&nbsp;&nbsp;&nbsp;" + commentMessage;
                    } %>
                    <%- markdown(commentMessage) %>
                    <div id="comment-item-form-wrapper-<%- comment._id %>"></div>
                </div>
            </div>
        </div>
        <% } %>
    </div>

    <% }else{ %>
        <div class="comment-empty">No comments yet</div>
    <% } %>
<% } %>