<% if(theme.comment_history){ %>
    <%
        var commentArray = [];
        var slug = post.slug;
        for (var data in site.data) {
            if (site.data.hasOwnProperty(data)) {
                var nameArray = data.split('/');
                if (nameArray[0] == "comments") {
                    if (site.data[data]._parent == slug) {
                        commentArray.push(site.data[data]);
                    }
                }
            }
        }
        if(commentArray.length > 0) {
            var hasComments = 0
            for(var i = commentArray.length - 1;i >= 0;i--){
                hasComments++;
                var comment = commentArray[i];
            if (comment.reply_to == "") {
                var hasReplies = 0;
                for (var replyIndex = commentArray.length - 1; replyIndex >= 0; replyIndex--) {
                    if (commentArray[replyIndex].reply_to == comment._id) {
                        hasReplies++;
                    }
                } %>
    <section class="comments">
        <article class="comment">
            <a class="comment-img">
                <img src="https://www.gravatar.com/avatar/<%- comment.email %>?s=60" alt="" width="60" height="60">
            </a>
            <div class="comment-body">
                <div class="text">
                    <%- markdown(comment.body) %>
                </div>
            </div>
            <p class="attribution">by <a><%- comment.name %></a> at <span class="comment-date"><%- date(comment.date, 'YYYY-MM-DD') %></span></p>
            <div id="<%- comment._id %>" class="comment-thread">

                <% if(hasReplies == 0){ %>
                <div class="comment-reply-button">
                    <button type="button" class="btn btn-success btn-sm float-right"
                            onclick="replyTo('<%- comment._id %>','<%- comment.name %>')">Reply
                    </button>
                </div>
                <% } %>
                <div class="clearfix"></div>
                    <section class="comment-replies">
                    <% for(var i2 = commentArray.length - 1;i2 >= 0;i2--){
                        var replyComment = commentArray[i2];
                    if (replyComment.reply_to == comment._id) { %>

                        <article class="comment-reply">
                            <a class="comment-img">
                                <img src="https://www.gravatar.com/avatar/<%- replyComment.email %>?s=60" alt="" width="60" height="60">
                            </a>
                            <div class="comment-body">
                                <div class="text">
                                    <div id="<%- replyComment._id %>">
                                        <%- markdown(replyComment.body) %>
                                    </div>
                                 </div>
                                <p class="attribution">by <a><%- replyComment.name %></a> at <span class="comment-date"><%- date(replyComment.date, 'YYYY-MM-DD') %></span></p>
                            </div>
                        </article>

                    <% } %>
                    <% } %>
                    </section>
                <% if (hasReplies > 0) { %>
                    <div class="comment-reply-button">
                        <button type="button" class="btn btn-success btn-sm float-right"
                                onclick="replyTo('<%- comment._id %>','<%- comment.name %>')">Reply to Thread
                        </button>
                    </div>
                    <div class="clearfix"></div>
                <% } %>
            </div>
        </article>
    </section>
        <% } %>
        <% } %>
    <% }else{ %>
        <div class="comment-empty">No comments yet</div>
    <% } %>
<% } %>