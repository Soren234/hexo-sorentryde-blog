<article id="<%= post.layout %>-<%= post.slug %>" class="article article-type-<%= post.layout %>" itemscope itemprop="blogPost">
    <%
    var commentArray = [];
    var slug = post.slug;
    for (i in site.data) {
        var nameArray = i.split('/');
        if(nameArray[0] == "comments") {
            if (site.data[i]._parent == slug) {
                commentArray.push(site.data[i]);
            }
        }
    }
    %>
  <div class="article-inner">
    <%- partial('post/gallery') %>
    <% if (post.link || post.title){ %>
      <header class="article-header">
        <%- partial('post/title', {class_name: 'article-title'}) %>
      </header>
      <div class="row justify-content-start article-meta">
          <div class="col-md-auto">
          <%- partial('post/profile') %>
          </div>
          <div class="col-md-auto">
          <%- partial('post/date', {class_name: 'article-date', date_format: null}) %>
          </div>
          <div class="col-md-auto">
          <%- partial('post/category') %>
          </div>
      </div>
    <% } %>
    <div class="article-entry" itemprop="articleBody">
      <% if (post.excerpt && index){ %>
        <%- post.excerpt %>
        <% if (theme.excerpt_link){ %>
          <div class="article-more-link">
            <a href="<%- url_for(post.path) %>"><%= theme.excerpt_link %></a>
          </div>
        <% } %>
      <% } else { %>
        <%- post.content %>
      <% } %>
    </div>
    <footer class="article-footer">
      <a data-url="<%- post.permalink %>" data-id="<%= post._id %>" class="article-share-link"><i data-feather="share-2" class="feather-16" stroke-width="2"></i> <%= __('share') %></a>
        <% if (post.comments){ %>
        <a href="<%- url_for(post.path) %>#article-nav" class="article-comment-link"><i data-feather="message-square" class="feather-16" stroke-width="2"></i> <%= __('comment') %> (<%- commentArray.length %>)</a>
      <% } %>
      <%- partial('post/tag') %>
    </footer>
  </div>
  <% if (!index){ %>
    <%- partial('post/nav') %>
  <% } %>
</article>

<% if (!index && post.comments){ %>
<section id="comments">
    <%- partial('show-comments') %>
    <%- partial('post-comments') %>
</section>
<% } %>