<!-- Use icons from fontawesome when you are adding new item in the contact list  -->

    <div class="profile-container">
        <% if(config['avatar']) { %>
            <img id = "avatar_pic" class="profile-img" src="<%= config['root'] %><%= config['avatar'] %>" />
        <% } %>

        <% if(config.name) { %>
        <h1 class="name">
            <%- config.name %>
        </h1>
        <% } %>

        <% if(config.tagline) { %>
        <h3 class="tagline">
            <%- config.tagline %>
        </h3>
        <% } %>
    </div><!--//profile-container-->
